<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             id="Definitions_1"
             targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="Process_Urlaubsantrag" name="Urlaubsantrag-Prozess" isExecutable="true">
    <startEvent id="StartEvent_1" name="Urlaubsantrag eingereicht"><outgoing>Flow_1</outgoing></startEvent>
    <task id="Task_AntragStellen" name="Mitarbeiter stellt Urlaubsantrag"><incoming>Flow_1</incoming><outgoing>Flow_2</outgoing></task>
    <task id="Task_AntragPruefen" name="Manager prüft Urlaubsantrag"><incoming>Flow_2</incoming><outgoing>Flow_3</outgoing></task>
    <task id="Task_MitarbeiterBenachrichtigenGenehmigt" name="Mitarbeiter über Genehmigung benachrichtigen"><incoming>Flow_4</incoming><outgoing>Flow_6</outgoing></task>
    <task id="Task_MitarbeiterBenachrichtigenAbgelehnt" name="Mitarbeiter über Ablehnung benachrichtigen"><incoming>Flow_5</incoming><outgoing>Flow_7</outgoing></task>
    <exclusiveGateway id="Gateway_Entscheidung" name="Antrag genehmigt?" isMarkerVisible="true"><incoming>Flow_3</incoming><outgoing>Flow_4</outgoing><outgoing>Flow_5</outgoing></exclusiveGateway>
    <endEvent id="EndEvent_Genehmigt" name="Urlaub genehmigt"><incoming>Flow_6</incoming></endEvent>
    <endEvent id="EndEvent_Abgelehnt" name="Urlaub abgelehnt"><incoming>Flow_7</incoming></endEvent>
    <sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_AntragStellen"/>
    <sequenceFlow id="Flow_2" sourceRef="Task_AntragStellen" targetRef="Task_AntragPruefen" name="Antrag weitergeleitet"/>
    <sequenceFlow id="Flow_3" sourceRef="Task_AntragPruefen" targetRef="Gateway_Entscheidung" name="Prüfung abgeschlossen"/>
    <sequenceFlow id="Flow_4" sourceRef="Gateway_Entscheidung" targetRef="Task_MitarbeiterBenachrichtigenGenehmigt" name="Ja – genehmigt"/>
    <sequenceFlow id="Flow_5" sourceRef="Gateway_Entscheidung" targetRef="Task_MitarbeiterBenachrichtigenAbgelehnt" name="Nein – abgelehnt"/>
    <sequenceFlow id="Flow_6" sourceRef="Task_MitarbeiterBenachrichtigenGenehmigt" targetRef="EndEvent_Genehmigt"/>
    <sequenceFlow id="Flow_7" sourceRef="Task_MitarbeiterBenachrichtigenAbgelehnt" targetRef="EndEvent_Abgelehnt"/>
  </process>
</definitions>